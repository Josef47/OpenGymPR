<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup (to the user's Google account / device transfer) keeps the log when switching phones. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="opengympr.db" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="opengympr.db" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
